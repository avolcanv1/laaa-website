# Optional — Laaa Tienda (Shopify Storefront API)
# Create a custom app in Shopify Admin → Settings → Apps and sales channels → Develop apps,
# enable "Storefront API", install on your store, then create a Storefront API access token.
# Use the store domain without https (e.g. your-store.myshopify.com).

# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
